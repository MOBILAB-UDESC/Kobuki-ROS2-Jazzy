<?xml version="1.0"?>

<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find kobuki_description)/model/D1/D1.gazebo.xacro"/>

    <xacro:macro name="D1_robot" params="parent *joint_origin">
        <joint name="D1_kobuki_joint" type="fixed">
            <xacro:insert_block name="joint_origin"/>
            <parent link="${parent}"/>
            <child link="D1_base_link"/>
        </joint>
        <link name="D1_base_link">
            <inertial>
                <origin xyz="-9.0106E-05 -0.00012378 0.033469" rpy="0 0 0"/>
                <mass value="0.16964"/>
                <inertia
                    ixx="0.00030483"
                    ixy="1.2051E-06"
                    ixz="3.9736E-06"
                    iyy="0.00031037"
                    iyz="8.0144E-07"
                    izz="0.00050913"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/base_link.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/base_link.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_1" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0 0 0.0738" rpy="0 0 0"/>
            <parent link="D1_base_link"/>
            <child link="D1_link_1"/>
            <axis xyz="0 0 -1"/>
            <limit lower="-2.35619449" upper="2.35619449" effort="3.33" velocity="1.05"/>
        </joint>

        <link name="D1_link_1">
            <inertial>
                <origin xyz="-0.0030892 6.1834E-05 0.031665" rpy="0 0 0"/>
                <mass value="0.14706"/>
                <inertia ixx="7.8054E-05" ixy="1.9698E-10" ixz="-1.574E-08"
                         iyy="6.6897E-05" iyz="-4.3439E-09"
                         izz="7.0773E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link1.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link1.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_2" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0 -0.0276 0.0578" rpy="0 0 0"/>
            <parent link="D1_link_1"/>
            <child link="D1_link_2"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="3.33" velocity="1.05"/>
        </joint>

        <link name="D1_link_2">
            <inertial>
                <origin xyz="5.7801E-05 0.027243 0.19413" rpy="0 0 0"/>
                <mass value="0.20987"/>
                <inertia ixx="0.00025832" ixy="-2.101E-11" ixz="-1.4864E-07"
                         iyy="0.00023175" iyz="-4.425E-09"
                         izz="6.5679E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link2.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link2.STL"/>
                </geometry>
            </collision>
        </link>

        <joint
            name="D1_joint_3" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0 -0.0004 0.27" rpy="0 0 0"/>
            <parent link="D1_link_2"/>
            <child link="D1_link_3"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="3.33" velocity="1.05"/>
        </joint>
        
        <link name="D1_link_3">
            <inertial>
                <origin xyz="0.016105 0.0275 0.044231" rpy="0 0 0"/>
                <mass
                    value="0.064921"/>
                <inertia ixx="2.0648E-05" ixy="-3.9865E-11" ixz="-2.0913E-06"
                         iyy="1.6024E-05" iyz="-5.5601E-11"
                         izz="1.2186E-05"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh
                    filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link3.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link3.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_4" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0.05 0.0275 0.041325" rpy="0 0 0"/>
            <parent link="D1_link_3"/>
            <child link="D1_link_4"/>
            <axis xyz="1 0 0"/>
            <limit lower="-2.36" upper="2.36" effort="1.67" velocity="1.73"/>
        </joint>

        <link name="D1_link_4">
            <inertial>
                <origin xyz="0.096072 3.157E-05 0.00025559" rpy="0 0 0"/>
                <mass value="0.081362"/>
                <inertia ixx="1.6724E-05" ixy="-5.5957E-08" ixz="9.45E-08"
                         iyy="5.1663E-05" iyz="1.6089E-12"
                         izz="6.1415E-05"/>
                </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link4.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link4.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_5" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0.15468 -0.0258 0.0001" rpy="0 0 0"/>
            <parent link="D1_link_4"/>
            <child link="D1_link_5"/>
            <axis xyz="0 1 0"/>
            <limit lower="-1.57" upper="1.57" effort="1.67" velocity="1.73"/>
        </joint>

        <link name="D1_link_5">
            <inertial>
                <origin xyz="0.044211 0.025813 0.0054296" rpy="0 0 0"/>
                <mass value="0.059846"/>
                <inertia ixx="1.4667E-05" ixy="-4.9109E-10" ixz="-4.7057E-07"
                         iyy="1.2009E-05" iyz="1.4753E-09"
                         izz="9.9767E-06"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link5.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link5.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_6" type="revolute"> <!-- type="revolute"> -->
            <origin xyz="0.0777 0.025822 -0.0010718" rpy="0 0 0"/>
            <parent link="D1_link_5"/>
            <child link="D1_link_6"/>
            <axis xyz="1 0 0"/>
            <limit lower="-2.36" upper="2.36" effort="1.67" velocity="1.73"/>
        </joint>
        
        <link name="D1_link_6">
            <inertial>
                <origin xyz="0.03844 -0.00044094 0.0060952" rpy="0 0 0"/>
                <mass value="0.12117"/>
                <inertia ixx="0.00011988" ixy="-9.0166E-08" ixz="1.1937E-06"
                         iyy="3.2466E-05" iyz="-2.1696E-09"
                         izz="0.0001058"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link6.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link6.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_L" type="fixed"> <!-- type="prismatic"> -->
            <origin xyz="0.0718 -0.033778 0.0031" rpy="0 0 0"/>
            <parent link="D1_link_6"/>
            <child link="D1_link_L"/>
            <axis xyz="0 1 0"/>
            <limit lower="0" upper="0.033" effort="15" velocity="0.02"/>
        </joint>

        <link name="D1_link_L">
            <inertial>
                <origin xyz="0.018562 -0.0073492 -0.0034988" rpy="0 0 0"/>
                <mass value="0.01333"/>
                <inertia ixx="1.0229E-06" ixy="-1.5002E-07" ixz="1.3407E-11"
                         iyy="2.3789E-06" iyz="-1.3846E-14"
                         izz="1.8134E-06"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link_L.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link_L.STL"/>
                </geometry>
            </collision>
        </link>

        <joint name="D1_joint_R" type="fixed"> <!-- type="prismatic"> -->
            <origin xyz="0.0718 0.033022 0.0031" rpy="0 0 0"/>
            <parent link="D1_link_6"/>
            <child link="D1_link_R"/>
            <axis xyz="0 -1 0"/>
            <limit lower="0" upper="0.033" effort="15" velocity="0.02"/>
        </joint>

        <link name="D1_link_R">
            <inertial>
                <origin xyz="0.018562 0.0073492 -0.0035012" rpy="0 0 0"/>
                <mass value="0.01333"/>
                <inertia ixx="1.0229E-06" ixy="1.5002E-07" ixz="-1.3407E-11"
                         iyy="2.3789E-06" iyz="-1.3811E-14"
                         izz="1.8134E-06"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link_R.STL"/>
                </geometry>
                <xacro:insert_block name="material_black"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/D1/Empty_Link_R.STL"/>
                </geometry>
            </collision>
        </link>
    </xacro:macro>

</robot>