<?xml version="1.0"?>

<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find kobuki_description)/model/camera/kobuki_camera.gazebo.xacro"/>

    <xacro:macro name="kobuki_camera" params="parent *joint_origin">

        <joint name="camera_joint" type="fixed">
            <xacro:insert_block name="joint_origin"/>
            <parent link="${parent}"/>
            <child link="camera_link"/>
        </joint>

        <link name="camera_link">
            <visual>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/d415s_rotated.stl" />
                </geometry>
                <xacro:insert_block name="material_light_grey"/>
                <!-- <origin xyz="0 0 0" rpy="0 ${PI/2} 0"/> -->
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/d415s_rotated.stl" />
                </geometry>
                <!-- <origin xyz="0 0 0" rpy="0 ${PI/2} 0"/> -->
            </collision>

            <inertial>
                <origin xyz="0 0 0.0"/>
                <mass value="0.064"/>
                <inertia ixx="0.003881243" ixy="0" ixz="0" iyy="0.000498940" iyz="0" izz="0.003879257" />
            </inertial>
        </link>

    </xacro:macro>

    <xacro:macro name="kobuki_optical_camera" params="parent *joint_origin">

        <joint name="camera__optical_joint" type="fixed">
            <xacro:insert_block name="joint_origin"/>
            <parent link="${parent}"/>
            <child link="camera_link_optical"/>
        </joint>

        <link name="camera_link_optical">
        </link>

    </xacro:macro>
</robot>