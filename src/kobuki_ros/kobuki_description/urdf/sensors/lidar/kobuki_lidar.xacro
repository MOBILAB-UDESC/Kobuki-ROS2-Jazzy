<?xml version="1.0"?>

<robot xmlns:xacro="https://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find kobuki_description)/urdf/sensors/lidar/kobuki_lidar.gazebo.xacro"/>

    <xacro:macro name="kobuki_lidar" params="parent *joint_origin">
        <joint name="lidar_joint" type="fixed">
            <xacro:insert_block name="joint_origin"/>
            <parent link="${parent}"/>
            <child link="lidar_link"/>
        </joint>
        <link name="lidar_link">
            <visual>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/lidar2_rotated.stl"/>
                </geometry>
            </visual>

            <collision>
                <geometry>
                    <mesh filename="file://$(find kobuki_description)/meshes/stl/lidar2_rotated.stl"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0"/>
                <mass value="0.170"/>
                <inertia ixx="0.000000087" ixy="0" ixz="0" iyy="0.000000087" iyz="0" izz="0.00006664" />
            </inertial>
        </link>
    </xacro:macro>
</robot>